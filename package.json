{
  "name": "source",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:fonts": "node scripts/check-font-axes.mjs",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css,yaml,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,yaml,json,md}\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.95",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.7",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3"
  }
