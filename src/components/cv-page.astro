---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import { about } from "../data/about";
import { skills } from "../data/skills";
//import profilePhoto from "../assets/tom-andersson-promo.jpg";

const experience = await getCollection("experience");
experience.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));

const projects = await getCollection("projects");
projects.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const featuredProj = projects.filter((p) => p.data.featured);

const education = await getCollection("education");
education.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));

const publications = await getCollection("publications");
publications.sort((a, b) => b.data.year - a.data.year);
---

<div>
    <nav
        class="fixed right-5 top-1/2 -translate-y-1/2 flex flex-col gap-2 z-10"
    >
        <a
            href="#section-about"
            title="About"
            class="block w-3 h-3 rounded-full bg-accent-soft/40 hover:bg-accent transition-colors"
        ></a>
        <a
            href="#section-experience"
            title="Experience"
            class="block w-3 h-3 rounded-full bg-accent-soft/40 hover:bg-accent transition-colors"
        ></a>
        <a
            href="#section-projects"
            title="Projects"
            class="block w-3 h-3 rounded-full bg-accent-soft/40 hover:bg-accent transition-colors"
        ></a>
        <a
            href="#section-education"
            title="Education"
            class="block w-3 h-3 rounded-full bg-accent-soft/40 hover:bg-accent transition-colors"
        ></a>
        <a
            href="#section-skills"
            title="Skills"
            class="block w-3 h-3 rounded-full bg-accent-soft/40 hover:bg-accent transition-colors"
        ></a>
        <a
            href="#section-publications"
            title="Publications"
            class="block w-3 h-3 rounded-full bg-accent-soft/40 hover:bg-accent transition-colors"
        ></a>
    </nav>

    <div class="w-full px-6 py-20" id="section-about">
        <div class="max-w-4xl mx-auto flex items-center gap-10 flex-wrap">
            <div class="flex-1 min-w-[260px]">
                <h1 class="text-5xl font-bold text-ink">{about.name}</h1>
                <p class="text-lg text-ink/70 mt-4">
                    {about.bio}
                </p>
            </div>
            <!-- <Image
                src={profilePhoto}
                alt="Tom Andersson"
                class="w-40 h-40 rounded-full object-cover border border-accent-soft/50 justify-center"
            /> -->
        </div>
    </div>

    <div class="w-full px-6 py-20 bg-bg-alt" id="section-experience">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-ink mb-8">Experience</h2>
            {
                experience.map((entry) => (
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-ink">
                            {entry.data.company}
                        </h3>
                        <h4 class="text-base font-normal text-ink">
                            {entry.data.role}
                        </h4>
                        <div class="text-sm text-ink/60 mb-1">
                            {entry.data.startDate} – {entry.data.endDate}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="w-full px-6 py-20" id="section-projects">
        <div class="max-w-4xl mx-auto">
            <div class="flex gap-3 mb-6">
                <button
                    type="button"
                    class="tab-button px-4 py-2 rounded-full border border-accent-soft text-sm bg-accent text-white"
                    data-tab="featured">Cherry picks</button
                >
                <button
                    type="button"
                    class="tab-button px-4 py-2 rounded-full border border-accent-soft text-sm"
                    data-tab="all">All projects</button
                >
            </div>
            <div class="grid">
                <div
                    class="tab-panel transition-opacity duration-500 [grid-area:1/1]"
                    data-panel="featured"
                >
                    {
                        featuredProj.map((p) => (
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold text-ink">
                                    {p.data.title}
                                </h3>
                                <div class="text-sm text-ink/60">
                                    {p.data.client} · {p.data.startDate}–
                                    {p.data.endDate}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div
                    class="tab-panel hidden opacity-0 transition-opacity duration-500 [grid-area:1/1]"
                    data-panel="all"
                >
                    {
                        projects.map((p) => (
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold text-ink">
                                    {p.data.title}
                                </h3>
                                <div class="text-sm text-ink/60">
                                    {p.data.client} · {p.data.startDate}–
                                    {p.data.endDate}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="w-full px-6 py-20 bg-bg-alt" id="section-education">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-ink mb-8">Education</h2>
            {
                education.map((e) => (
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-ink">
                            {e.data.institution}
                        </h3>
                        <div class="text-sm text-ink/60">
                            {e.data.startDate} – {e.data.endDate} ·{" "}
                            {e.data.degree}{" "}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="w-full px-6 py-20" id="section-skills">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-ink mb-8">Skills</h2>
            {
                skills.map((categories) => (
                    <div class="mb-6">
                        <h3 class="text-sm font-semibold uppercase tracking-wide text-ink/60 mb-2">
                            {categories.category}
                        </h3>
                        <div class="flex flex-wrap gap-2">
                            {categories.items.map((item) => (
                                <span class="px-3 py-1 rounded-full bg-accent-soft/20 text-ink text-sm">
                                    {item}
                                </span>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="w-full px-6 py-20 bg-bg-alt" id="section-publications">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-ink mb-8">Publications</h2>
            {
                publications.map((publication) => (
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-ink">
                            {publication.data.title}
                        </h3>
                        <div class="text-sm text-ink/60">
                            {publication.data.year} · {publication.data.venue}
                        </div>
                        <a
                            class="text-sm text-ink/60"
                            href={publication.data.url}
                        >
                            {publication.data.url}
                        </a>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<script>
    TabControl();
    SectionObserver();

    async function TabControl() {
        const buttons =
            document.querySelectorAll<HTMLButtonElement>(".tab-button");
        const panels = document.querySelectorAll<HTMLDivElement>(".tab-panel");

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const target = button.dataset.tab;

                panels.forEach((panel) => {
                    setPanelVisible(panel, panel.dataset.panel === target);
                });

                buttons.forEach((b) => {
                    const isActive = b === button;
                    b.classList.toggle("bg-accent", isActive);
                    b.classList.toggle("text-white", isActive);
                    b.classList.toggle("border-accent", isActive);
                });
            });
        });
    }

    function setPanelVisible(panel: HTMLElement, visible: boolean) {
        if (visible) {
            panel.classList.remove("hidden");
            // wait one frame so the browser registers "display:block" before we change opacity —
            // otherwise both changes happen in the same instant and there's nothing to animate between
            requestAnimationFrame(() => panel.classList.remove("opacity-0"));
        } else {
            panel.classList.add("opacity-0");
            // only actually remove it from layout once the fade-out transition has finished
            panel.addEventListener(
                "transitionend",
                () => panel.classList.add("hidden"),
                { once: true },
            );
        }
    }

    async function SectionObserver() {
        const sections =
            document.querySelectorAll<HTMLElement>('[id^="section-"]');
        const navLinks = document.querySelectorAll<HTMLAnchorElement>(
            'nav a[href^="#section-"]',
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        navLinks.forEach((link) => {
                            const isActive =
                                link.getAttribute("href") === `#${id}`;
                            link.classList.toggle("bg-accent", isActive);
                            link.classList.toggle(
                                "bg-accent-soft/40",
                                !isActive,
                            );
                        });
                    }
                });
            },
            { rootMargin: "-50% 0px -50% 0px" },
        );
        sections.forEach((section) => observer.observe(section));
    }
</script>
