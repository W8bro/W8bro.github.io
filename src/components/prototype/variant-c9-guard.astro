---
// PROTOTYPE - throwaway. Variant C9: variant C8 plus one fix.
// Same idiom and references as the whole C line (Images/nature-conservation-hero-01.png +
// Images/wooden-cabin-booking.png). Earlier variants kept beside this one.
//
// THE FIX: "See work" used to wrap onto a second line and sit under the 2013 / Present /
// 5 roles chips once the window got narrow. It now hides instead.
//
// Done with a CONTAINER query, not a media query, because the button should react to the
// width of the panel it lives in rather than the width of the window - the split band is a
// fraction of the viewport on desktop but goes full width below 960px, so a viewport
// breakpoint would be wrong in one of those two states.
//
// The threshold is measured, not guessed. At 1440x900 the row needs:
//     chips 272px + button 130px + three 0.6rem gaps 29px = 431px
// of panel content-box width. Verified empirically by ramping the viewport 1600 -> 320 in
// 10px steps: the row is fine at 435px of inner width and wraps at 425px (viewport 500 vs
// 490). The query fires at 470px, which leaves ~39px of headroom so the button disappears
// just BEFORE it would wrap rather than on the same frame, and absorbs any chip-width
// change from a different webfont load.
//
// Nothing is lost by hiding it: "See work" points at #c9-projects, which the nav also
// links to as "Projects", so the destination is still reachable at every width.
import type { CVData } from './cv-data';
const { data } = Astro.props as { data: CVData };
const PHOTO = {
    hero: 'https://picsum.photos/seed/w8bro-mill/1900/1200?grayscale',
    split: 'https://picsum.photos/seed/w8bro-cell/1400/1600?grayscale',
};
const yr = (s: string) => s.slice(0, 4);

const LINKS: { where: string; title: string; note: string; url: string }[] = [
    { where: 'Spotify', title: 'Bench playlist', note: 'What a test rig sounds like at 2am', url: 'https://open.spotify.com/' },
    { where: 'Spotify', title: 'Control theory, the podcast', note: 'Long-form, occasionally about bicycles', url: 'https://open.spotify.com/' },
    { where: 'GitHub', title: 'W8bro', note: 'This Site, and whatever else is half-finished', url: 'https://github.com/W8bro' },
    { where: 'DiVA', title: 'Thesis, in full', note: 'Cascade control of a riderless bicycle', url: 'https://www.diva-portal.org/' },
];
---

<div class="c9">
    <!-- HERO: full-bleed-single-image, one photograph carrying the whole frame. -->
    <section class="c9-hero" id="c9-about">
        <div class="c9-photo c9-photo-hero">
            <img src={PHOTO.hero} alt="" loading="eager" />
        </div>

        <header class="c9-nav">
            <a class="is-on" href="#c9-about">Tom</a>
            <a href="#c9-experience">Experience</a>
            <a href="#c9-projects">Projects</a>
            <a href="#c9-skills">Skills</a>
            <a href="#c9-papers">Education</a>
            <a href="#c9-elsewhere">Elsewhere</a>
            <span class="c9-glyph">≋</span>
        </header>

        <!-- Nature: the wordmark rotated ninety degrees, climbing the left edge. -->
        <div class="c9-margin">
            <span class="c9-kicker">Systems by</span>
            <span class="c9-word">ANDERSSON</span>
        </div>

        <!-- Nature: a narrow right-hand rail, hairline-divided, right-aligned. -->
        <aside class="c9-rail">
            <p>{data.about.bio}</p>
            <p>{data.projects.length} delivered systems across steel, robotics, medical and process industry — {data.experience.length} positions since 2013.</p>
            <a class="c9-ghost" href="#">Download CV</a>
        </aside>
    </section>

    <!-- Wooden: the split band. Photograph left with an enormous tight-tracked light
         grotesque headline; charcoal listing panel right. -->
    <section class="c9-split" id="c9-experience">
        <div class="c9-split-l">
            <div class="c9-photo c9-photo-split">
                <img src={PHOTO.split} alt="" loading="lazy" />
            </div>
            <h2 class="c9-huge">BUILT FOR<br />HEAVY<br />INDUSTRY</h2>
            <p class="c9-sub"><span class="c9-glyph">≋</span> Test systems, control software and robot cell platforms that run on a factory floor</p>
            <div class="c9-inputs">
                <span>2013</span>
                <span>Present</span>
                <span>{data.experience.length} roles</span>
                <a class="c9-square" href="#c9-projects">See work <span>&#8594;</span></a>
            </div>
        </div>
        <div class="c9-split-r">
            <div class="c9-panel-head">
                <h3>EVERY CHAPTER<br />OF THE WORK</h3>
                <span class="c9-count">{data.experience.length}</span>
            </div>
            <div class="c9-roles">
                {data.experience.map((e) => (
                    <article class="c9-role">
                        <h4>{e.data.company}</h4>
                        <p class="c9-role-meta">{e.data.role}</p>
                        <p class="c9-role-meta">{yr(e.data.startDate)} — {e.data.endDate} · {e.data.location}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="c9-band" id="c9-projects">
        <div class="c9-band-head">
            <h2>Selected work</h2>
            <div class="c9-tabs">
                <button type="button" class="is-on" data-c9-tab="f">Cherry picks</button>
                <button type="button" data-c9-tab="all">All {data.projects.length}</button>
            </div>
        </div>
        <div class="c9-stack">
            <div data-c9-panel="f">
                {data.featured.map((p) => (
                    <article class="c9-proj">
                        <span class="c9-year">{yr(p.data.startDate)}</span>
                        <div>
                            <h3>{p.data.title}</h3>
                            <p>{p.data.client} · {p.data.location}</p>
                        </div>
                        <span class="c9-tag">{p.data.tags[0]}</span>
                    </article>
                ))}
            </div>
            <div data-c9-panel="all" hidden>
                {data.projects.map((p) => (
                    <article class="c9-proj">
                        <span class="c9-year">{yr(p.data.startDate)}</span>
                        <div>
                            <h3>{p.data.title}</h3>
                            <p>{p.data.client} · {p.data.location}</p>
                        </div>
                        <span class="c9-tag">{p.data.tags[0]}</span>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="c9-band c9-band-alt" id="c9-skills">
        <div class="c9-band-head"><h2>Capability</h2></div>
        <dl class="c9-skills">
            {data.skills.map((c) => (
                <div>
                    <dt>{c.category}</dt>
                    <dd>{c.items.join(' · ')}</dd>
                </div>
            ))}
        </dl>
    </section>

    <section class="c9-band c9-two" id="c9-papers">
        <div>
            <div class="c9-band-head"><h2>Education</h2></div>
            {data.education.map((e) => (
                <article class="c9-proj c9-proj-tight">
                    <span class="c9-year">{yr(e.data.endDate)}</span>
                    <div>
                        <h3>{e.data.institution}</h3>
                        <p>{e.data.degree}, {e.data.field}</p>
                    </div>
                </article>
            ))}
        </div>
        <div>
            <div class="c9-band-head"><h2>Published</h2></div>
            {data.publications.map((p) => (
                <a class="c9-proj c9-proj-tight" href={p.data.url}>
                    <span class="c9-year">{p.data.year}</span>
                    <div>
                        <h3>{p.data.title}</h3>
                        <p>{p.data.venue} ↗</p>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <section class="c9-band c9-band-alt" id="c9-elsewhere">
        <div class="c9-band-head">
            <h2>Elsewhere</h2>
            <span class="c9-tag">{LINKS.length} links</span>
        </div>
        <div>
            {LINKS.map((l) => (
                <a class="c9-proj c9-link" href={l.url}>
                    <span class="c9-where">{l.where}</span>
                    <div>
                        <h3>{l.title}</h3>
                        <p>{l.note}</p>
                    </div>
                    <span class="c9-tag c9-arrow">↗</span>
                </a>
            ))}
        </div>
    </section>

    <footer class="c9-foot">
        <span>W8BRO.GITHUB.IO</span>
        <span>Bodoni Moda 600–700, opsz pinned / Inter</span>
    </footer>
</div>

<style>
    .c9 {
        --paper: #fbf7f1;
        --ink: #22201d;
        --terra: #c56a4c;
        /* the reference sets its rotated wordmark in a LIGHT salmon, because the ground
           behind it is dark */
        --terra-lift: #e58f6a;
        --earth: #47361a;
        background: var(--paper);
        color: var(--ink);
        font-family: Inter, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    /* Every photograph is pulled grayscale and duotoned into the earth range: the
       collection renders nature (and, here, industry) in earth and gold. */
    /* Reveal on scroll. Scoped to .reveal-ready, which only the script adds, so nothing
       is hidden if JS never runs. `translate` is used instead of `transform` so the
       rotated wordmark keeps its own rotation. */
    .c9.reveal-ready [data-reveal] {
        opacity: 0;
        translate: 0 14px;
        transition:
            opacity 0.75s cubic-bezier(0.2, 0.6, 0.2, 1),
            translate 0.75s cubic-bezier(0.2, 0.6, 0.2, 1);
    }
    .c9.reveal-ready [data-reveal].is-in {
        opacity: 1;
        translate: none;
    }
    @media (prefers-reduced-motion: reduce) {
        .c9.reveal-ready [data-reveal],
        .c9.reveal-ready [data-reveal].is-in {
            opacity: 1;
            translate: none;
            transition: none;
        }
    }

    .c9-photo {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: linear-gradient(150deg, #6e5a34 0%, #8a6b3e 34%, #46381f 74%, #2a2114 100%);
    }
    .c9-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        mix-blend-mode: luminosity;
        opacity: 0.95;
    }
    /* the fade that keeps overlaid text legible */
    .c9-photo::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, rgba(42, 33, 20, 0.62) 0%, rgba(42, 33, 20, 0.18) 46%, rgba(42, 33, 20, 0.55) 100%);
    }

    /* ---------- hero ---------- */
    .c9-hero {
        position: relative;
        min-height: min(96vh, 980px);
        display: flex;
        overflow: hidden;
        color: var(--paper);
    }
    .c9-photo-hero {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    /* An EVEN deeper grade across the whole frame, rather than a fade down one edge.
       The reference's hero is a dark warm jungle; this gets the same ground without
       putting a panel over the navigation. */
    .c9-photo-hero::after {
        background: linear-gradient(
            176deg,
            rgba(38, 28, 16, 0.6) 0%,
            rgba(38, 28, 16, 0.46) 42%,
            rgba(38, 28, 16, 0.52) 72%,
            rgba(38, 28, 16, 0.66) 100%
        );
    }
    .c9-nav {
        position: absolute;
        /* above .c9-margin: the poster margin is a full-height column that comes later in
           the DOM, so at equal z-index it was swallowing clicks on the nav links. The dark
           fade only made an existing hit-testing bug visible. */
        z-index: 4;
        top: clamp(1.2rem, 3vw, 2.4rem);
        left: clamp(1.2rem, 3vw, 2.6rem);
        right: clamp(1.2rem, 3vw, 2.6rem);
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 2.4vw, 2rem);
        font-size: 1.02rem;
        font-weight: 400;
    }
    .c9-nav a {
        color: var(--paper);
        text-decoration: none;
    }
    .c9-nav a.is-on {
        color: var(--terra-lift);
        border-bottom: 1px solid var(--terra-lift);
    }
    .c9-glyph {
        margin-left: auto;
        font-size: 1.4rem;
        color: var(--terra-lift);
    }

    /* Nature's poster margin. */
    .c9-margin {
        position: relative;
        z-index: 2;
        isolation: isolate;
        /* nothing in the poster margin is interactive, so it should never take a click */
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        /* clear the nav: the poster margin climbs the edge, it does not run over it */
        padding: clamp(5rem, 9vw, 8rem) 0 clamp(1.4rem, 4vw, 3rem) clamp(1.2rem, 3vw, 2.6rem);
        min-width: 0;
    }
    .c9-kicker {
        font-family: "Bodoni Moda", Georgia, serif;
        font-weight: 600;
        font-variation-settings: "opsz" 16;
        font-size: clamp(1rem, 1.5vw, 1.35rem);
        line-height: 1.15;
        max-width: 7ch;
        margin-bottom: 0.7rem;
    }
    .c9-word {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-family: "Bodoni Moda", Georgia, serif;
        font-weight: 700;
        /* the margin has to hold all nine letters at any viewport height, so the
           wordmark is sized off the height, not the width */
        font-size: clamp(2rem, min(5.4vw, 6.6vh), 5.4rem);
        line-height: 0.9;
        /* the whole point: heavier stems, and opsz pinned low so Bodoni renders its text
           design rather than the hairline display design it defaults to at this size */
        font-weight: 700;
        font-variation-settings: "opsz" 14, "wght" 700;
        letter-spacing: 0.035em;
        color: var(--terra-lift);
    }

    /* Nature's right-hand rail. */
    .c9-rail {
        position: relative;
        z-index: 2;
        margin: auto 0 clamp(1.4rem, 4vw, 3rem) auto;
        width: min(30ch, 34vw);
        padding-right: clamp(1.2rem, 3vw, 2.6rem);
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1.1rem;
    }
    .c9-rail p {
        margin: 0;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid rgba(251, 247, 241, 0.35);
        font-size: 0.92rem;
        font-weight: 300;
        line-height: 1.55;
    }
    .c9-ghost {
        border: 1px solid rgba(251, 247, 241, 0.55);
        border-radius: 999px;
        padding: 0.62rem 1.3rem;
        font-size: 0.8rem;
        color: var(--paper);
        text-decoration: none;
    }
    .c9-ghost:hover {
        background: rgba(251, 247, 241, 0.14);
    }

    /* ---------- Wooden split ---------- */
    .c9-split {
        display: grid;
        grid-template-columns: 1fr minmax(320px, 38%);
        gap: 10px;
        padding: 10px;
        background: #100f0d;
    }
    .c9-split-l {
        /* query container for the chip row below; see the note at the top of this file */
        container-type: inline-size;
        container-name: panel;
        position: relative;
        min-height: min(82vh, 820px);
        border-radius: 20px;
        overflow: hidden;
        padding: clamp(1.4rem, 3.4vw, 3rem);
        display: flex;
        flex-direction: column;
        color: var(--paper);
    }
    .c9-photo-split {
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: 20px;
    }
    .c9-huge {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: clamp(2.5rem, 8.2vw, 7rem);
        font-weight: 200;
        line-height: 0.94;
        letter-spacing: -0.045em;
    }
    .c9-sub {
        position: relative;
        z-index: 1;
        margin: auto 0 1.4rem;
        max-width: 34ch;
        display: flex;
        gap: 0.7rem;
        font-size: 0.92rem;
        font-weight: 300;
        line-height: 1.5;
    }
    /* Wooden: frosted-glass inputs floating over the photograph beside a hard white
       square button. */
    .c9-inputs {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: stretch;
    }
    /* direct children only: the arrow inside .c9-square is a span too */
    .c9-inputs > span {
        border-radius: 10px;
        padding: 0.95rem 1.5rem;
        background: rgba(251, 247, 241, 0.12);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: inset 0 0 0 1px rgba(251, 247, 241, 0.18);
        font-size: 0.88rem;
    }
    /* was a hard white slab; now the same frosted glass as the chips beside it, kept
       distinct by a brighter hairline and an arrow rather than by a block of white */
    .c9-square {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        border-radius: 10px;
        padding: 0.95rem 1.4rem;
        background: rgba(251, 247, 241, 0.17);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: inset 0 0 0 1px rgba(251, 247, 241, 0.45);
        color: var(--paper);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition:
            background 0.3s ease,
            box-shadow 0.3s ease;
    }
    .c9-square span {
        color: var(--terra-lift);
        transition: translate 0.3s ease;
    }
    .c9-square:hover {
        background: rgba(251, 247, 241, 0.27);
        box-shadow: inset 0 0 0 1px rgba(251, 247, 241, 0.7);
    }
    .c9-square:hover span {
        translate: 3px 0;
    }

    /* Measured: the chips + button + gaps need 431px of panel content box. Hide at 470px
       so the button goes just before it would wrap under the chips, never on top of them. */
    @container panel (max-width: 470px) {
        .c9-square {
            display: none;
        }
    }
    /* Fallback for engines without container queries: the panel is full width below the
       960px split breakpoint, so viewport width tracks panel width closely there. */
    @supports not (container-type: inline-size) {
        @media (max-width: 535px) {
            .c9-square {
                display: none;
            }
        }
    }

    .c9-split-r {
        border-radius: 20px;
        background: #1a1917;
        color: var(--paper);
        padding: clamp(1.4rem, 3vw, 2.4rem);
        display: flex;
        flex-direction: column;
    }
    .c9-panel-head {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }
    .c9-panel-head h3 {
        margin: 0;
        font-size: clamp(1.05rem, 1.5vw, 1.3rem);
        font-weight: 400;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }
    .c9-count {
        margin-left: auto;
        font-family: "Bodoni Moda", Georgia, serif;
        font-weight: 600;
        font-variation-settings: "opsz" 16;
        font-size: 1.5rem;
        color: rgba(251, 247, 241, 0.5);
        line-height: 1;
    }
    /* every role listed, rather than one at a time behind arrows */
    .c9-roles {
        margin-top: 1.6rem;
        display: flex;
        flex-direction: column;
    }
    .c9-role {
        padding: 0.95rem 0;
        border-top: 1px solid rgba(251, 247, 241, 0.16);
    }
    .c9-role:last-child {
        border-bottom: 1px solid rgba(251, 247, 241, 0.16);
    }
    .c9-role h4 {
        margin: 0;
        font-family: "Bodoni Moda", Georgia, serif;
        font-size: clamp(1.15rem, 1.7vw, 1.45rem);
        font-weight: 600;
        font-variation-settings: "opsz" 16;
        letter-spacing: -0.005em;
    }
    .c9-role-meta {
        margin: 0.2rem 0 0;
        font-size: 0.86rem;
        font-weight: 300;
        color: rgba(251, 247, 241, 0.6);
    }

    /* ---------- bands ---------- */
    .c9-band {
        padding: clamp(3.4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 4.5rem);
        max-width: 1500px;
        margin: 0 auto;
    }
    .c9-band-alt {
        background: #f2ece2;
        max-width: none;
    }
    .c9-band-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(34, 32, 29, 0.2);
    }
    .c9-band-head h2 {
        margin: 0;
        font-family: "Bodoni Moda", Georgia, serif;
        font-size: clamp(1.9rem, 4.4vw, 3.4rem);
        font-weight: 700;
        font-variation-settings: "opsz" 18, "wght" 700;
        letter-spacing: -0.012em;
    }
    .c9-tabs {
        display: flex;
        gap: 1.3rem;
    }
    .c9-tabs button {
        border: 0;
        background: transparent;
        font: inherit;
        font-size: 0.86rem;
        color: rgba(34, 32, 29, 0.45);
        padding: 0.2rem 0;
        border-bottom: 1px solid transparent;
        cursor: pointer;
    }
    .c9-tabs button.is-on {
        color: var(--terra);
        border-bottom-color: var(--terra);
    }

    .c9-stack {
        display: grid;
    }
    .c9-stack > * {
        grid-area: 1 / 1;
    }
    .c9-stack > [hidden] {
        display: none;
    }
    .c9-proj {
        display: grid;
        grid-template-columns: 6ch 1fr auto;
        gap: 1.6rem;
        align-items: baseline;
        padding: 1.25rem 0;
        border-bottom: 1px solid rgba(34, 32, 29, 0.13);
        text-decoration: none;
        color: inherit;
    }
    .c9-proj-tight {
        grid-template-columns: 6ch 1fr;
    }
    .c9-year {
        font-family: "Bodoni Moda", Georgia, serif;
        font-size: 1.05rem;
        font-weight: 600;
        font-variation-settings: "opsz" 8;
        color: #a8543a;
    }
    .c9-proj h3 {
        margin: 0;
        max-width: 62ch;
        font-family: "Bodoni Moda", Georgia, serif;
        font-size: clamp(1.14rem, 2vw, 1.62rem);
        font-weight: 600;
        /* opsz 8 is the text extreme of Bodoni Moda's optical-size axis: the sturdiest,
           most open cut it has. In a 23-item list that matters more than weight does. */
        font-variation-settings: "opsz" 8, "wght" 600;
        letter-spacing: -0.002em;
        line-height: 1.28;
    }
    .c9-proj p {
        margin: 0.34rem 0 0;
        font-size: 0.88rem;
        font-weight: 400;
        color: rgba(34, 32, 29, 0.8);
    }
    .c9-proj:hover h3 {
        color: var(--terra);
    }
    .c9-tag {
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(34, 32, 29, 0.62);
        white-space: nowrap;
    }

    /* the Elsewhere rows reuse the assignment-row idiom so the band reads as native */
    .c9-where {
        font-family: "Bodoni Moda", Georgia, serif;
        font-size: 1.02rem;
        font-weight: 600;
        font-variation-settings: "opsz" 8;
        color: #a8543a;
    }
    .c9-link:hover h3 {
        color: var(--terra);
    }
    .c9-arrow {
        font-size: 0.95rem;
        letter-spacing: 0;
    }

    .c9-skills {
        margin: 0;
        max-width: 1500px;
    }
    .c9-skills > div {
        display: grid;
        grid-template-columns: minmax(160px, 22%) 1fr;
        gap: 1.6rem;
        padding: 1.3rem 0;
        border-bottom: 1px solid rgba(34, 32, 29, 0.13);
    }
    .c9-skills dt {
        font-family: "Bodoni Moda", Georgia, serif;
        font-size: 1.3rem;
        font-weight: 700;
        /* body scale, so the same text cut the assignment list needed */
        font-variation-settings: "opsz" 8, "wght" 700;
        letter-spacing: -0.002em;
        line-height: 1.25;
    }
    .c9-skills dd {
        margin: 0;
        font-weight: 400;
        line-height: 1.7;
        color: rgba(34, 32, 29, 0.86);
    }

    .c9-two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(1.6rem, 5vw, 4.5rem);
    }
    .c9-foot {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.4rem clamp(1.2rem, 4vw, 4.5rem);
        border-top: 1px solid rgba(34, 32, 29, 0.2);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(34, 32, 29, 0.5);
    }

    @media (max-width: 950px) {
        .c9-split,
        .c9-two,
        .c9-skills > div {
            grid-template-columns: 1fr;
        }
        .c9-rail {
            display: none;
        }
        .c9-word {
            font-size: clamp(2.6rem, 15vw, 5rem);
        }
        .c9-proj {
            grid-template-columns: 5ch 1fr;
        }
        .c9-tag {
            display: none;
        }
    }
</style>

<script>
    // ---------- reveal on scroll ----------
    const root = document.querySelector<HTMLElement>(".c9");

    if (root) {
        const REVEAL = [
            ".c9-kicker",
            ".c9-word",
            ".c9-rail > *",
            ".c9-huge",
            ".c9-sub",
            ".c9-inputs",
            ".c9-panel-head",
            ".c9-role",
            ".c9-band-head",
            ".c9-proj",
            ".c9-skills > div",
            ".c9-foot > *",
        ].join(", ");

        const targets = [...root.querySelectorAll<HTMLElement>(REVEAL)];
        targets.forEach((el) => el.setAttribute("data-reveal", ""));

        // stagger by position among revealing siblings, capped so long lists don't crawl
        const seen = new Map<Element, number>();
        targets.forEach((el) => {
            const parent = el.parentElement;
            if (!parent) return;
            const i = seen.get(parent) ?? 0;
            seen.set(parent, i + 1);
            el.style.transitionDelay = `${Math.min(i * 55, 330)}ms`;
        });

        // added last, so the page is never briefly blank while the above runs
        root.classList.add("reveal-ready");

        const show = (el: Element) => {
            el.classList.add("is-in");
            io.unobserve(el);
        };

        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((e) => {
                    if (!e.isIntersecting) return;
                    show(e.target); // reveal once; never re-hide on scroll up
                });
            },
            {
                // threshold 0, deliberately: with a fractional threshold an element that
                // straddles the rootMargin dead zone can have too little of itself inside
                // the root to ever fire. That hid the "Download CV" button on load - it sat
                // 3px inside a root shrunk by 12%, i.e. 7% of its own height. The negative
                // rootMargin already provides the "reveal just after it comes up" delay.
                rootMargin: "0px 0px -12% 0px",
                threshold: 0,
            },
        );
        targets.forEach((el) => io.observe(el));

        // The bottom rootMargin above makes the last 12% of the viewport a dead zone,
        // which is nice for timing but means anything sitting in the final screenful of
        // the DOCUMENT can never satisfy the observer - the footer colophon stayed at
        // opacity 0 forever. So: once the reader has actually reached the end of the page,
        // nothing is allowed to still be hidden. Also covers a page too short to scroll.
        const revealTail = () => {
            const doc = document.documentElement;
            if (window.innerHeight + Math.ceil(window.scrollY) < doc.scrollHeight - 2) return;
            targets.forEach(show);
        };
        window.addEventListener("scroll", revealTail, { passive: true });
        window.addEventListener("resize", revealTail);
        // NOT called synchronously: at first paint the photographs have no intrinsic size
        // yet, so scrollHeight can still equal innerHeight - revealTail would then decide
        // the page was already fully scrolled and reveal everything at once. Wait until
        // layout has settled, which also covers a page genuinely too short to scroll.
        if (document.readyState === "complete") requestAnimationFrame(revealTail);
        else window.addEventListener("load", () => requestAnimationFrame(revealTail));
    }

    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-c9-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-c9-panel]");
    tabs.forEach((t) =>
        t.addEventListener("click", () => {
            tabs.forEach((o) => o.classList.toggle("is-on", o === t));
            panels.forEach((p) => (p.hidden = p.dataset.c9Panel !== t.dataset.c9Tab));
            panels.forEach((p) => {
                if (p.hidden) return;
                p.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-in"));
            });
        }),
    );

</script>
