---
import CVPage from "../components/cv-page.astro";
import { about } from "../data/about";
import "../styles/global.css";

const title = `${about.firstName} ${about.lastName} — ${about.role}`;
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={about.bio} />

        {/* Bodoni Moda carries the display voice, Inter is the text face. Both are now
		    self-hosted — the @font-face rules live in global.css and the files in
		    public/fonts/, so there is no third-party request and nothing to preconnect to.

		    These two preloads are the latin subsets, the only ones this page is certain to
		    need. Without them the fonts are not discovered until global.css has been fetched
		    and parsed, which costs a round trip on the text that matters most. The latin-ext
		    subsets are deliberately not preloaded — unicode-range fetches them only if the
		    content actually calls for them.

		    `crossorigin` is required even though these are same-origin: the CSS Font Loading
		    spec fetches every @font-face src in CORS mode, so a preload without it is a
		    different request in the browser's eyes and the file is downloaded twice. Verified
		    with scripts/verify-fonts.mjs, which fails if a font is fetched more than once. */}
        <link
            rel="preload"
            href="/fonts/bodoni-moda-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/inter-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body>
        <CVPage />
    </body>
</html>
